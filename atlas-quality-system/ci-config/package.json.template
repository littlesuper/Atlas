{
  "_comment_top": "Atlas项目 package.json 模板。请根据实际项目调整。",

  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas - Web Application",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },

  "scripts": {
    "_comment_dev": "==== 开发命令 ====",
    "dev": "vite",
    "dev:debug": "vite --debug",
    "preview": "vite preview",

    "_comment_build": "==== 构建命令 ====",
    "build": "tsc && vite build",
    "analyze": "vite build --mode analyze",

    "_comment_lint": "==== Lint与格式 ====",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:style": "stylelint '**/*.{css,scss}'",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,json,md,css}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,json,md,css}'",
    "typecheck": "tsc --noEmit",

    "_comment_test": "==== 测试命令 ====",
    "test": "vitest",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test --grep @a11y",
    "test:mutation": "stryker run",

    "_comment_db": "==== 数据库命令 ====",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:rollback": "prisma migrate resolve --rolled-back",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:test": "NODE_ENV=test tsx prisma/seed.test.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",

    "_comment_storybook": "==== Storybook ====",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",

    "_comment_quality": "==== 质量检查 ====",
    "quality": "npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "audit": "npm audit --audit-level=high",
    "outdated": "npm outdated",

    "_comment_release": "==== 发布相关 ====",
    "prepare": "husky install",
    "release": "echo 'Release should only happen via CI/CD'"
  },

  "_comment_dependencies": "==== 生产依赖(运行时需要) ====",
  "dependencies": {
    "_comment_core": "核心框架",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",

    "_comment_state": "状态管理",
    "@tanstack/react-query": "^5.51.0",
    "zustand": "^4.5.0",

    "_comment_form": "表单与验证",
    "react-hook-form": "^7.52.0",
    "@hookform/resolvers": "^3.9.0",
    "zod": "^3.23.0",

    "_comment_ui": "UI库",
    "@radix-ui/react-alert-dialog": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "lucide-react": "^0.439.0",
    "tailwind-merge": "^2.5.0",
    "clsx": "^2.1.0",

    "_comment_http": "HTTP客户端",
    "axios": "^1.7.0",

    "_comment_utility": "工具库",
    "date-fns": "^3.6.0",
    "lodash-es": "^4.17.0",

    "_comment_observability": "可观测性",
    "@sentry/react": "^8.30.0",
    "@vercel/analytics": "^1.3.0",

    "_comment_feature_flag": "Feature Flags",
    "@unleash/proxy-client-react": "^4.5.0"
  },

  "_comment_devDependencies": "==== 开发依赖 ====",
  "devDependencies": {
    "_comment_typescript": "TypeScript相关",
    "typescript": "^5.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^22.5.0",
    "@types/lodash-es": "^4.17.0",

    "_comment_build": "构建工具",
    "vite": "^5.4.0",
    "@vitejs/plugin-react-swc": "^3.7.0",

    "_comment_styling": "样式",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.0",

    "_comment_lint": "Lint工具",
    "eslint": "^9.10.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-security": "^3.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",

    "_comment_test_unit": "单元测试",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/user-event": "^14.5.0",
    "happy-dom": "^15.7.0",
    "msw": "^2.4.0",

    "_comment_test_e2e": "E2E测试",
    "@playwright/test": "^1.47.0",
    "@axe-core/playwright": "^4.10.0",

    "_comment_test_mutation": "变更测试",
    "@stryker-mutator/core": "^8.5.0",
    "@stryker-mutator/vitest-runner": "^8.5.0",

    "_comment_db": "数据库",
    "prisma": "^5.19.0",
    "@prisma/client": "^5.19.0",

    "_comment_storybook": "Storybook",
    "storybook": "^8.3.0",
    "@storybook/react-vite": "^8.3.0",
    "@storybook/test": "^8.3.0",
    "@chromatic-com/storybook": "^2.0.0",

    "_comment_quality": "代码质量工具",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "commitlint": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "dependency-cruiser": "^16.4.0",
    "madge": "^8.0.0",
    "depcheck": "^1.4.0",
    "ts-prune": "^0.10.0",
    "license-checker": "^25.0.0",
    "bundlesize": "^0.18.0",

    "_comment_perf": "性能测试",
    "lighthouse": "^12.2.0",
    "@lhci/cli": "^0.14.0"
  },

  "_comment_lintstaged": "==== lint-staged配置 ====",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ]
  },

  "_comment_commitlint": "==== Commit规范 ====",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },

  "_comment_browserslist": "==== 浏览器支持 ====",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not ie 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },

  "_comment_bundlesize": "==== Bundle大小限制 ====",
  "bundlesize": [
    {
      "path": "./dist/assets/*.js",
      "maxSize": "250 kB",
      "compression": "gzip"
    },
    {
      "path": "./dist/assets/*.css",
      "maxSize": "50 kB",
      "compression": "gzip"
    }
  ]
}
