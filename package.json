{
  "name": "hwsystem",
  "version": "1.1.22",
  "description": "贝锐硬件管理系统",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "lint": "eslint . --max-warnings=0",
    "test:e2e:p0": "playwright test --grep \"@smoke|@p0\"",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:a11y": "playwright test --grep @a11y",
    "test:e2e:visual": "playwright test --grep @visual",
    "test:e2e:p1": "playwright test --grep @p1",
    "test:e2e:p2": "playwright test --grep @p2",
    "test:e2e:reuse": "PLAYWRIGHT_REUSE_SERVER=true playwright test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.6",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "lint-staged": {
    "client/src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0"
    ],
    "server/src/**/*.ts": [
      "eslint --fix --max-warnings=0"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
