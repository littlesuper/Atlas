# 数据库连接（SQLite 开发环境 / PostgreSQL 生产环境）
DATABASE_URL="file:./dev.db"

# JWT 密钥（必须设置，否则服务无法启动）
JWT_SECRET="your-jwt-secret-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"

# 服务端口
PORT=3000

# AI API 配置（留空则使用内置规则引擎）
AI_API_KEY=""
AI_API_URL=""

# Sentry 错误追踪（留空则禁用）
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0"
SENTRY_RELEASE=""

# 技术指标端点（生产环境必须配置 METRICS_TOKEN 才能访问 /api/metrics）
METRICS_TOKEN=""
SLOW_REQUEST_THRESHOLD_MS="1000"

# 告警检查脚本（alerts:check）配置
ALERT_WEBHOOK_URL=""
ALERT_SERVICE="atlas-api"
METRICS_URL=""

# 事故上下文采集脚本（incident:collect）配置
INCIDENT_BASE_URL=""
INCIDENT_REQUEST_ID=""

# 发布前检查脚本（release:precheck）配置
RELEASE_BASE_URL=""

# Feature Flags（支持 JSON：{"risk.ai":true}；也支持逗号简写：risk.ai,!weekly-report）
FEATURE_FLAGS=""

# 企业微信扫码登录（留空则禁用企微登录）
WECOM_CORP_ID=""
WECOM_AGENT_ID=""
WECOM_SECRET=""
WECOM_REDIRECT_URI="http://localhost:5173/login"

# CORS 允许的前端域名（逗号分隔，默认 localhost）
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# 运行环境
NODE_ENV="development"
